{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "ops-requisition-auditor ATS-Neutral Integration & Governance API",
    "version": "1.5.0",
    "x-contract-version": "ats-neutral-contract-1.0",
    "description": "Deterministic, human-in-the-loop JD Alignment, Requisition Quality (RQS), Explainable Batch Screening, and Internal Mobility integration contract. Enforces PENDING_HUMAN_REVIEW and never permits autonomous hiring decisions."
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealthStatus",
        "summary": "Verify integration service health and human-in-the-loop governance mode.",
        "responses": {
          "200": {
            "description": "Service healthy"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiSpec",
        "summary": "Retrieve the OpenAPI 3.1.0 and ATS-neutral JSON Schema specification.",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1.0 JSON document"
          }
        }
      }
    },
    "/v1/evaluate/application": {
      "post": {
        "operationId": "evaluateCandidateApplication",
        "summary": "Score a candidate application in blind mode and return an ATS-neutral governance envelope.",
        "responses": {
          "200": {
            "description": "NeutralEvaluationAndGovernanceEnvelope"
          },
          "422": {
            "description": "Governance or anti-automation policy violation"
          }
        }
      }
    },
    "/v1/webhooks/events": {
      "post": {
        "operationId": "receiveSignedWebhookEvent",
        "summary": "Process an HMAC-SHA256 signed webhook event from Greenhouse, Lever, Ashby, or Workday HRIS.",
        "responses": {
          "200": {
            "description": "Webhook processed with audit & human-review preservation"
          },
          "401": {
            "description": "Invalid HMAC-SHA256 signature or expired replay timestamp"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NeutralRequisitionEnvelope": {
        "type": "object",
        "required": [
          "contract_version",
          "requisition_id",
          "external_system",
          "title"
        ],
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "ats-neutral-contract-1.0"
          },
          "requisition_id": {
            "type": "string"
          },
          "external_system": {
            "type": "string",
            "enum": [
              "ashby",
              "greenhouse",
              "hr_open_xml",
              "lever",
              "neutral",
              "workday_hris"
            ]
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "raw_description_text": {
            "type": "string"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "alignment": {
            "type": "object"
          }
        }
      },
      "NeutralCandidateApplicationEnvelope": {
        "type": "object",
        "required": [
          "contract_version",
          "application_id",
          "candidate_id",
          "requisition_id",
          "resume_text"
        ],
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "ats-neutral-contract-1.0"
          },
          "application_id": {
            "type": "string"
          },
          "candidate_id": {
            "type": "string"
          },
          "pseudonym_token": {
            "type": "string"
          },
          "requisition_id": {
            "type": "string"
          },
          "resume_text": {
            "type": "string"
          },
          "blind_mode": {
            "type": "boolean",
            "default": true
          },
          "consent": {
            "type": "object"
          },
          "human_decision": {
            "type": "object"
          }
        }
      },
      "NeutralEvaluationAndGovernanceEnvelope": {
        "type": "object",
        "required": [
          "contract_version",
          "evaluation_id",
          "requisition_id",
          "application_id",
          "pseudonym_token",
          "composite_score",
          "literal_only_score",
          "plausible_score_interval",
          "measurement_confidence",
          "evidence_completeness_pct",
          "disposition_status",
          "auto_rejection_permitted",
          "decision_sha256",
          "chain_entry_sha256",
          "version_manifest"
        ],
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "ats-neutral-contract-1.0"
          },
          "evaluation_id": {
            "type": "string"
          },
          "composite_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          "literal_only_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          "plausible_score_interval": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "measurement_confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "evidence_completeness_pct": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          "disposition_status": {
            "type": "string",
            "enum": [
              "ADVANCE",
              "DO_NOT_ADVANCE",
              "HOLD",
              "PENDING_HUMAN_REVIEW"
            ]
          },
          "auto_rejection_permitted": {
            "type": "boolean",
            "const": false
          },
          "reviewer_id": {
            "type": "string"
          },
          "reviewer_role": {
            "type": "string"
          },
          "decision_timestamp": {
            "type": "string"
          },
          "is_override": {
            "type": "boolean"
          },
          "override_reason": {
            "type": "string"
          },
          "decision_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "chain_entry_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "version_manifest": {
            "type": "object"
          }
        }
      }
    }
  }
}